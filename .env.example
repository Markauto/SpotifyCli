# Copy this file to .env (for local dev) or to ~/.config/spotify-cli/.env
# (for normal use), then fill in your own values. Never commit a real .env.
#
# Real environment variables always take precedence over either .env file.

# Required. Client ID of the Spotify app you created at
# https://developer.spotify.com/dashboard
# This is a public identifier, not a secret — the CLI uses Authorization Code
# + PKCE, so no client secret is needed or stored anywhere.
SPOTIFY_CLIENT_ID=your_spotify_client_id_here

# Optional. Port the CLI's local OAuth callback server listens on during
# `spotify auth`. Must match the port in the Redirect URI you registered in
# the Spotify Dashboard (default redirect URI is http://127.0.0.1:8888/callback).
SPOTIFY_CLI_REDIRECT_PORT=8888

# Optional. Overrides the redirect URI entirely (must exactly match — or,
# for a loopback address, be covered by — an entry registered in the
# Spotify Dashboard). Usually you only need SPOTIFY_CLI_REDIRECT_PORT above.
# SPOTIFY_CLI_REDIRECT_URI=http://127.0.0.1:8888/callback
